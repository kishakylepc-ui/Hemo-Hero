# Copy this file to .env and fill in the values.
# Never commit .env (it is in .gitignore).

# ------------------------------------------------------------
# Supabase (required)
# Supabase dashboard -> Project Settings -> API
# ------------------------------------------------------------

SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key: used for sign-up and sign-in calls.
SUPABASE_ANON_KEY=your-anon-key

# Secret "service_role" key: server only. It bypasses Row Level
# Security, so it must never go into the mobile or admin app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# Optional
# ------------------------------------------------------------

# Port of this API server. The mobile app expects 5000.
PORT=5000

# Where links in sign-up and password-reset emails point.
FRONTEND_URL=http://localhost:8081

NODE_ENV=development

# Days a donor must wait between donations (default 90).
# Set to 0 while testing the donation cycle with the same accounts.
# DONATION_INTERVAL_DAYS=0

# Routing server for the live trip map (default: the free public
# OSRM demo server).
# OSRM_URL=https://router.project-osrm.org

# Address lookup for "Use my Current Location" (default: the free
# public OpenStreetMap Nominatim server).
# NOMINATIM_URL=https://nominatim.openstreetmap.org
