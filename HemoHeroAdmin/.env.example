# Copy this file to .env.
# Never commit .env (it is in .gitignore).

# Address of the Hemo-Hero API server.
#
# Leave it as localhost (or unset) for local development. The
# portal then finds the server by itself: in a browser, the
# computer that served the page; on an iPad (Expo Go), the
# computer Expo Go loaded the portal from. Port 5000 either way.
EXPO_PUBLIC_API_URL=http://localhost:5000
#
# Set a real address only to use a different server, for
# example a deployed API: https://your-api.example.com

# Minutes without activity before the portal signs out (a
# warning shows 1 minute before). Default 15. A shorter time,
# e.g. 2, makes the sign-out quick to show in a demo. Restart
# Expo after changing it.
# EXPO_PUBLIC_IDLE_TIMEOUT_MINUTES=2
