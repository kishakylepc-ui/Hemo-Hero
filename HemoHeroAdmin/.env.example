# Copy this file to .env.
# Never commit .env (it is in .gitignore).

# Address of the Hemo-Hero API server.
#
# In a browser on the same computer as the server:
EXPO_PUBLIC_API_URL=http://localhost:5000
#
# On an iPad (Expo Go), use the computer's network address
# instead, e.g. http://192.168.1.5:5000 (the server prints it at
# start-up as "Phone (same network)").
