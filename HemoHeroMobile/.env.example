# Copy this file to .env if you need to change a setting.
# Never commit .env (it is in .gitignore).

# Address of the Hemo-Hero API server.
#
# Leave it unset for local development: the app uses the address
# of the computer running `npx expo start` (the same one Expo Go
# loaded the app from) with port 5000, so it works on any Wi-Fi or
# hotspot without changes.
#
# Set it only to use a server somewhere else, for example:
# EXPO_PUBLIC_API_URL=https://api.example.com

# Minutes without activity before the app signs out (a warning
# shows 1 minute before). Default 15. A shorter time, e.g. 2,
# makes the sign-out quick to show in a demo. Restart Expo after
# changing it.
# EXPO_PUBLIC_IDLE_TIMEOUT_MINUTES=2
